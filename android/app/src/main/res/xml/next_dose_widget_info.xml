<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 by default; can be stretched to a slim wide bar (4×1) or larger.
     The app pushes updates whenever the schedule or a dose changes; the
     30 min period is only a fallback. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/next_dose_widget_small"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/next_dose_widget_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
