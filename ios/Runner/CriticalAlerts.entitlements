<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NOT wired into the build. Signing fails if the provisioning profile lacks
  this entitlement, so add it only after Apple approves the request
  (https://developer.apple.com/contact/request/notifications-critical-alerts-entitlement/):
  copy the key below into Runner/Runner.entitlements (which the Runner target
  already uses, for the widget's App Group). The Dart side already asks for
  the permission and marks alarm notifications critical.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.usernotifications.critical-alerts</key>
	<true/>
</dict>
</plist>
